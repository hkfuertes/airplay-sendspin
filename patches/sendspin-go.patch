+func TestPlayerRole_UsesDynamicAudioFormat(t *testing.T) {
+	role := NewPlayerRole(PlayerRoleConfig{
+		SampleRate: 48000,
+		Channels:   2,
+		BitDepth:   24,
+		AudioFormat: func() (int, int, int) {
+			return 44100, 2, 16
+		},
+	})
+	sc := &ServerClient{
+		id:    "c1",
+		roles: []string{"player@v1"},
+		capabilities: &protocol.PlayerV1Support{SupportedFormats: []protocol.AudioFormat{
+			{Codec: "pcm", SampleRate: 44100, Channels: 2, BitDepth: 16},
+		}},
+		sendChan: make(chan interface{}, 1),
+	}
+
+	role.OnClientJoin(sc)
+	message, ok := (<-sc.sendChan).(protocol.Message)
+	if !ok || message.Type != "stream/start" {
+		t.Fatalf("message = %#v, want stream/start", message)
+	}
+	start, ok := message.Payload.(protocol.StreamStart)
+	if !ok || start.Player == nil {
+		t.Fatalf("stream/start payload = %#v", message.Payload)
+	}
+	if got := start.Player; got.SampleRate != 44100 || got.Channels != 2 || got.BitDepth != 16 {
+		t.Fatalf("stream format = %+v, want 44100/2/16", got)
+	}
+}
