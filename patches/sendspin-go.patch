+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	s.shutdownMu.RLock()
+	shutdown := s.isShutdown
+	s.shutdownMu.RUnlock()
+	if shutdown {
+		return fmt.Errorf("server is shut down")
+	}
+
+	log.Printf("Starting outbound stream to %s at %s", info.Name, clientInfoURL(info))
+	s.wg.Add(1)
+	go func() {
+		defer s.wg.Done()
+		s.streamAudio()
+	}()
+
+	dialCtx, cancel := context.WithCancel(ctx)
+	s.dialerCancel = cancel
+	result := make(chan error, 1)
+	s.wg.Add(1)
+	go func() {
+		defer s.wg.Done()
+		result <- dialAndHandle(dialCtx, info, s.handleConnection)
+	}()
+
+	var err error
+	select {
+	case err = <-result:
+	case <-ctx.Done():
+		err = ctx.Err()
+	case <-s.stopChan:
+	}
+
+	s.Stop()
+	s.cleanup()
+	return err
+}
