+// SetVolume changes a connected player's volume (0-100).
+func (s *Server) SetVolume(clientID string, volume int) error {
+	if volume < 0 || volume > 100 {
+		return fmt.Errorf("volume must be between 0 and 100")
+	}
+	s.clientsMu.RLock()
+	c := s.clients[clientID]
+	s.clientsMu.RUnlock()
+	if c == nil {
+		return fmt.Errorf("client %q is not connected", clientID)
+	}
+	return c.Send("server/command", protocol.ServerCommandMessage{
+		Player: &protocol.PlayerCommand{Command: "volume", Volume: volume},
+	})
+}
