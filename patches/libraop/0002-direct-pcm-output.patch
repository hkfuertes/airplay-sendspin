+/*---------------------------------------------------------------------------*/
+static void *pcm_thread_func(void *arg) {
+	raopst_t *ctx = (raopst_t*) arg;
+	struct timeval timeout = { 0, 0 };
+
+	while (ctx->running) {
+		int16_t *pcm;
+		size_t bytes = 0;
+		bool ready = false;
+
+		pthread_mutex_lock(&ctx->ab_mutex);
+		if ((pcm = _buffer_get_frame(ctx, &bytes)) != NULL) {
+			if (bytes <= ctx->pcm_copy_size) {
+				memcpy(ctx->pcm_copy, pcm, bytes);
+				ready = true;
+			} else {
+				LOG_ERROR("[%p]: PCM frame too large: %zu", ctx, bytes);
+			}
+			timeout.tv_usec = ctx->pause ? (ctx->frame_size * 1000000) / 44100 : 0;
+		} else {
+			timeout.tv_usec = (2 * ctx->frame_size * 1000000) / 44100;
+		}
+		pthread_mutex_unlock(&ctx->ab_mutex);
+
+		if (ready) ctx->pcm_cb(ctx->pcm_owner, ctx->pcm_copy, bytes / 4);
+		select(0, NULL, NULL, NULL, &timeout);
+	}
+
+	LOG_INFO("[%p]: terminating PCM output", ctx);
+	return NULL;
+}
