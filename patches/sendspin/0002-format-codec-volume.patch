--- /dev/null
+++ b/pkg/sendspin/server_stream_test.go
@@ -0,0 +1,27 @@
+package sendspin
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+
+	"github.com/Sendspin/sendspin-go/pkg/protocol"
+)
+
+func TestEncodePCM16(t *testing.T) {
+	got := encodePCM([]int32{0, 1, -1, 32767, -32768}, 16)
+	want := []byte{0, 0, 1, 0, 255, 255, 255, 127, 0, 128}
+	if !bytes.Equal(got, want) {
+		t.Fatalf("encodePCM(16) = %v, want %v", got, want)
+	}
+}
+
+func TestNegotiateCodecPrefersCompatiblePCM(t *testing.T) {
+	c := &ServerClient{capabilities: &protocol.PlayerV1Support{SupportedFormats: []protocol.AudioFormat{
+		{Codec: "flac", SampleRate: 48000, Channels: 2, BitDepth: 16},
+		{Codec: "pcm", SampleRate: 48000, Channels: 2, BitDepth: 16},
+	}}}
+	if got := negotiateCodec(c, 48000, 2, 16, "pcm"); got != "pcm" {
+		t.Fatalf("codec = %q, want pcm", got)
+	}
+}
