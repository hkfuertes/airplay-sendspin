diff --git a/pkg/sendspin/source.go b/pkg/sendspin/source.go
index 05aa9df..67cdf61 100644
--- a/pkg/sendspin/source.go
+++ b/pkg/sendspin/source.go
@@ -20,3 +20,18 @@ type AudioSource interface {
 	// Close closes the audio source
 	Close() error
 }
+
+// TimedAudioSource serves the chunk for a playback timestamp. Servers share a
+// clock and chunk grid, so sources keyed by timestamp (a multiroom group) give
+// players on different servers the same audio for the same instant.
+type TimedAudioSource interface {
+	AudioSource
+	ReadAt(samples []int32, playbackTime int64) (int, error)
+}
+
+func readSource(source AudioSource, samples []int32, playbackTime int64) (int, error) {
+	if timed, ok := source.(TimedAudioSource); ok {
+		return timed.ReadAt(samples, playbackTime)
+	}
+	return source.Read(samples)
+}
