+const (
+	chunkUs = int64(ChunkDurationMs) * 1000
+	aheadUs = int64(BufferAheadMs) * 1000
+
+	// initialSyncSettleUs lets a player apply its initial client/time burst
+	// before its first timestamped audio arrives.
+	initialSyncSettleUs int64 = 100_000
+	// noSyncFallbackUs: a player that never sends client/time still gets audio
+	// this long after hello.
+	noSyncFallbackUs int64 = 500_000
