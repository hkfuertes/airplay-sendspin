+			"right": {name: "right", source: right, codec: "pcm", helloAt: -noSyncFallbackUs, sendChan: make(chan interface{}, 1)},
+		},
+	}
+
+	server.generateAndSendChunk(42)
+	if left.reads != 1 || right.reads != 1 {
