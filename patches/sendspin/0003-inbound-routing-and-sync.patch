+
+// audioReady holds a client's audio until its clock can map our timestamps:
+// audio anchored before the first sync lands at a garbage position and is
+// dragged into place over seconds of audible snaps.
+// ponytail: a player whose first client/time comes >500 ms after hello still races; raise noSyncFallbackUs if one does.
+func audioReady(helloAt, initialSyncAt, now int64) bool {
+	if initialSyncAt != 0 {
+		return now-initialSyncAt >= initialSyncSettleUs
+	}
+	return now-helloAt >= noSyncFallbackUs
