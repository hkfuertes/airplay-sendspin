+	for i := 1; i < len(sent); i++ {
+		if sent[i]-sent[i-1] != chunkUs {
+			t.Fatalf("chunk %d at %d, want %d", i, sent[i], sent[i-1]+chunkUs)
+		}
+	}
+	now += 2 * aheadUs // stall past the whole buffer: new timeline
+	if start, n := timeline(next, now); start != now+aheadUs || n != 1 {
+		t.Fatalf("after stall got (%d, %d), want (%d, 1)", start, n, now+aheadUs)
+	}
+}
