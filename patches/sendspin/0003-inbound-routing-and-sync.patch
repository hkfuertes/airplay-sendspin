+// many consecutive chunks are due. Timestamps advance exactly one chunk per
+// chunk: receivers that place audio by timestamp (EchoLocal) otherwise get a
+// gap or an overlap at every tick's jitter. The ticker only paces: a late tick
+// is caught up, and a stall past the whole buffer starts a new timeline.
+func timeline(next, now int64) (int64, int) {
+	if next < now {
+		next = now + aheadUs
+	}
+	limit := now + aheadUs + chunkUs/2
+	if next > limit {
+		return next, 0
+	}
+	return next, int((limit-next)/chunkUs) + 1
+}
